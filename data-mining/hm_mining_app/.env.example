# Sao chép file này thành .env và điền giá trị thực
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/hm_mining

# Thư mục lưu mô hình đã huấn luyện (joblib + json metadata)
MODEL_STORE=./models_store

# Tham số mô hình
KMEANS_N_CLUSTERS=5
KMEANS_SAMPLE_SIZE=100000
APRIORI_MIN_SUPPORT=0.01
APRIORI_MIN_CONFIDENCE=0.20
RF_PREDICTION_WINDOW_DAYS=7
RF_SAMPLE_SIZE=300000

# Lịch retrain (cron). Lưu ý: comment phải ở dòng riêng — nếu để inline
# `KEY=value  # comment` thì khi copy ra shell hoặc Docker env block sẽ làm
# CronTrigger raise ValueError. python-dotenv tự strip nên `.env` thuần thì OK.

# L1 KMeans — Chủ nhật 02:00 UTC
RETRAIN_L1_CRON=0 2 * * 0
# L2 Apriori — Chủ nhật 03:00 UTC (sau L1)
RETRAIN_L2_CRON=0 3 * * 0
# L3 Random Forest — Hằng ngày 01:00 UTC
RETRAIN_L3_CRON=0 1 * * *

# Cờ bật scheduler
ENABLE_SCHEDULER=true
